DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_DEBUG=1
# استبدل 192.168.1.10 بعنوان IP الحقيقي للحاسوب الذي يشغل الخادم.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.10:5173

# اختياري: تضبطهما أداة النشر أو CI فقط ليظهرا في شاشة «حول التطبيق». ليسا سرّين.
# APP_COMMIT=
# APP_BUILD_DATE=
